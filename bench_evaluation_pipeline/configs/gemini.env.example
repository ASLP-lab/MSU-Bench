# ── Gemini 2.5 Flash / OpenAI-compatible generateContent endpoint ──
# Copy to gemini.env and fill in your own values.

# Base URL (no trailing /v1beta)
GEMINI_BASE_URL="https://YOUR_GEMINI_ENDPOINT"

# API key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Model name — anything served by the endpoint above, e.g.
#   gemini-2.5-flash / gemini-2.5-pro / gemini-3-flash-preview
GEMINI_MODEL="gemini-2.5-flash"

# Concurrency for step2
NUM_WORKERS=16
