# ── Doubao-Seed passthrough (reference / non-default backend) ──
# Copy to doubao.env and fill in your own values.

DOUBAO_URL="http://YOUR_DOUBAO_ENDPOINT/api/v3/chat/completions"
DOUBAO_APP_ID="YOUR_APP_ID"
DOUBAO_APP_KEY="YOUR_APP_KEY"
DOUBAO_MODEL="doubao-seed-2-0-lite"
DOUBAO_PROVIDER="doubao"

NUM_WORKERS=16
